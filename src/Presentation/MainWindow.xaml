<Window x:Class="Mskpy.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{Binding WindowTitle}" Width="1100" Height="850" MinWidth="700" MinHeight="600"
 Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontFamily="Segoe UI" WindowStartupLocation="CenterScreen">
   <Window.InputBindings><KeyBinding Key="Escape" Command="{Binding Cancel}"/><KeyBinding Key="F5" Command="{Binding Refresh}"/></Window.InputBindings>
 <DockPanel Background="{StaticResource Bg}">
  <Border DockPanel.Dock="Top" Background="#1C1B1F" Padding="26,20"><DockPanel>
   <TextBlock DockPanel.Dock="Right" Text="{Binding BuildLabel}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
    <TextBlock DockPanel.Dock="Right" Text="session not yet verified - submit may be refused" Foreground="#FFB4AB" VerticalAlignment="Center" Margin="0,0,16,0" Visibility="{Binding IsSessionUnverified,Converter={StaticResource BoolVisibility}}"/>
   <TextBlock Text="Renewable Energy" FontSize="26" FontWeight="SemiBold"/>
  </DockPanel></Border>
  <Border DockPanel.Dock="Bottom" Background="#2B2832" Padding="24,12"><DockPanel>
   <Button DockPanel.Dock="Right" Content="Cancel" Command="{Binding Cancel}" Visibility="{Binding IsBusy,Converter={StaticResource BoolVisibility}}" Padding="14,6"/>
   <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
  </DockPanel></Border>
  <StackPanel DockPanel.Dock="Top" Margin="24,10" Visibility="{Binding HasError,Converter={StaticResource BoolVisibility}}"><TextBlock Text="{Binding Error}" Foreground="#FFB4AB" AutomationProperties.LiveSetting="Polite"/></StackPanel>
  <Grid>
   <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding IsSignedOut,Converter={StaticResource BoolVisibility}}">
    <StackPanel Width="430" Margin="0,36,0,40" VerticalAlignment="Center">
     <TextBlock Text="Renewable Energy" FontSize="30" TextAlignment="Center"/>
     <TextBlock Text="Android reference 2.6.4" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,8,0,24"/>
     <StackPanel IsEnabled="{Binding IsIdle}">
      <TextBlock Text="Account type" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" Padding="10" FontSize="16"/>
      <StackPanel Visibility="{Binding IsAgency,Converter={StaticResource BoolVisibility}}" Margin="0,14,0,0"><TextBlock Text="Select Scheme" Margin="0,0,0,8"/><ComboBox ItemsSource="{Binding Schemes}" DisplayMemberPath="Label" SelectedItem="{Binding SelectedScheme}" Padding="10" FontSize="15"/></StackPanel>
      <Label Content="Username" Foreground="{StaticResource Text}" Padding="0,18,0,8"/><TextBox Text="{Binding Username,UpdateSourceTrigger=PropertyChanged}" MaxLength="50" AutomationProperties.Name="Username"/>
      <Label Content="Password" Foreground="{StaticResource Text}" Padding="0,18,0,8"/><PasswordBox x:Name="Password" AutomationProperties.Name="Password"><PasswordBox.InputBindings><KeyBinding Key="Return" Command="{Binding Login}"/></PasswordBox.InputBindings></PasswordBox>
     </StackPanel>
      <CheckBox Content="Stay signed in" IsChecked="{Binding StaySignedIn}" Foreground="{StaticResource Text}" Margin="0,18,0,0" AutomationProperties.Name="Stay signed in" ToolTip="Keep the sign-in on this machine, encrypted for your Windows account. Signing out forgets it."/>
     <Button Content="Login" Command="{Binding Login}" HorizontalContentAlignment="Center" Margin="0,22,0,0"/>
     <TextBlock Text="Your password is cleared from the input when login starts and is never saved." FontSize="13" Foreground="{StaticResource Muted}" TextAlignment="Center" Margin="0,18,0,0"/>
    </StackPanel>
   </ScrollViewer>
   <DockPanel Visibility="{Binding IsSignedIn,Converter={StaticResource BoolVisibility}}">
     <Border DockPanel.Dock="Left" Background="#201E25" Padding="12,22"><Border.Style><Style TargetType="Border"><Setter Property="Width" Value="180"/><Style.Triggers><DataTrigger Binding="{Binding IsCompactSidebar}" Value="True"><Setter Property="Width" Value="56"/><Setter Property="Padding" Value="4,22"/></DataTrigger></Style.Triggers></Style></Border.Style><StackPanel>
     <Button Content="Profile" Command="{Binding Navigate}" CommandParameter="Profile" ToolTip="Profile" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsProfilePage}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#281C60"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="Settings" Command="{Binding Navigate}" CommandParameter="Settings" ToolTip="Settings" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsSettingsPage}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#281C60"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="Diagnostics" Command="{Binding Navigate}" CommandParameter="Diagnostics" ToolTip="Diagnostics" HorizontalContentAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsDiagnostics}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#281C60"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="Inspection" Command="{Binding OpenInspection}" HorizontalContentAlignment="Left" ToolTip="Open linestaff-inspection section"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsInspectionSection}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#281C60"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="Waiting on SDO" Command="{Binding ShowBlocked}" HorizontalContentAlignment="Left" ToolTip="Records waiting on the SDO"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsBlocked}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#281C60"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
     <Button Content="Returned" Command="{Binding ShowReturned}" HorizontalContentAlignment="Left" ToolTip="Records the server returned, with the verbatim response"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{StaticResource Text}"/><Style.Triggers><DataTrigger Binding="{Binding IsReturned}" Value="True"><Setter Property="Background" Value="{StaticResource Accent}"/><Setter Property="Foreground" Value="#281C60"/></DataTrigger></Style.Triggers></Style></Button.Style></Button>
      <Button Content="{Binding NewCountBadge}" Command="{Binding OpenInspection}" Style="{StaticResource LinkButton}" Foreground="{StaticResource Accent}" HorizontalAlignment="Left" Margin="12,2,0,0" Visibility="{Binding HasArrivals,Converter={StaticResource BoolVisibility}}" AutomationProperties.Name="New arrivals" ToolTip="Records the harvest brought in - click for the list"/>
     <Button Content="Sign out" Command="{Binding SignOut}" ToolTip="Sign out" Background="Transparent" Foreground="{StaticResource Muted}" HorizontalContentAlignment="Left" Margin="0,26,0,0"/>
    </StackPanel></Border>
    <Grid Margin="28,24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock Text="{Binding PageTitle}" FontSize="26" Margin="0,0,0,22"/>
     <Grid Grid.Row="1" Visibility="{Binding IsList,Converter={StaticResource BoolVisibility}}"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <Grid Grid.Row="0" Margin="0,0,0,8"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel Grid.Row="0" VerticalAlignment="Center">
         <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding Refresh}" Margin="12,0,0,0" VerticalAlignment="Center" Padding="10,4"/>
         <RadioButton GroupName="listscope" Content="{Binding MyPendingChip}" IsChecked="{Binding ListScope, Converter={StaticResource EqualsValue}, ConverterParameter=MyPending}" FontSize="13" Margin="0,0,10,0" Padding="12,6" VerticalAlignment="Center" AutomationProperties.Name="Show my pending records"/>
         <RadioButton GroupName="listscope" Content="{Binding AllChip}" IsChecked="{Binding ListScope, Converter={StaticResource EqualsValue}, ConverterParameter=All}" FontSize="13" Margin="0,0,10,0" Padding="12,6" VerticalAlignment="Center" AutomationProperties.Name="Show all records"/>
         <TextBox Text="{Binding Search,UpdateSourceTrigger=PropertyChanged}" Width="280" MinWidth="180" AutomationProperties.Name="Search loaded applications" ToolTip="Search loaded applications" VerticalAlignment="Center" Margin="12,0,0,0"/>
         <TextBlock Text="{Binding ReturnRateHeader}" Foreground="{StaticResource Muted}" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"/>
        </DockPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0" Visibility="{Binding IsIndexStale,Converter={StaticResource BoolVisibility}}">
         <TextBlock Text="{Binding StaleIndexWarning}" Foreground="#FFB4AB" FontSize="13" VerticalAlignment="Center"/>
         <Button Content="Reload index" Command="{Binding ReloadIndexCommand}" Margin="10,0,0,0" Padding="10,3" FontSize="12" VerticalAlignment="Center" ToolTip="Re-read index.tsv and restart the harvester without restarting the app"/>
        </StackPanel>
       </Grid>
       <TextBlock Grid.Row="1" Text="{Binding ModuleDescription}" Margin="0,14,0,14"/>
       <ListBox x:Name="ApplicationList" Grid.Row="2" ItemsSource="{Binding Applications}" SelectedItem="{Binding SelectedApplication}" Background="Transparent" BorderThickness="0" Foreground="{StaticResource Text}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
        <ListBox.ContextMenu><ContextMenu IsOpen="{Binding PlacementTarget.DataContext.ContextMenuOpen,RelativeSource={RelativeSource Self},Mode=TwoWay}"><MenuItem Header="Details" InputGestureText="right-click" Command="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},Path=PlacementTarget.DataContext.ViewDetails}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},Path=PlacementTarget.SelectedItem}"/></ContextMenu></ListBox.ContextMenu>
       <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="8"/><Setter Property="Margin" Value="0,0,0,10"/></Style></ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate><DataTemplate><Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18"><DockPanel><StackPanel><TextBlock Text="{Binding Identity}" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="{Binding Summary}" Margin="0,8,0,0"/></StackPanel></DockPanel></Border></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
       <DockPanel Grid.Row="3" Margin="0,16,0,0"><Button DockPanel.Dock="Right" Content="Details" Style="{StaticResource LinkButton}" AutomationProperties.Name="Details" ToolTip="The selected record's own fields - its cpf and the officers it was seen under" Command="{Binding ViewDetails}" Visibility="{Binding HasSelection,Converter={StaticResource BoolVisibility}}"/><TextBlock Text="{Binding RecordCount}" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/><TextBlock Text="{Binding NewCountBadge}" Foreground="{StaticResource Accent}" FontSize="13" VerticalAlignment="Center" Margin="12,0,0,0"/></DockPanel>
     </Grid>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsReturned,Converter={StaticResource BoolVisibility}}"><StackPanel>
      <TextBlock Text="Server responses are shown verbatim, exactly as received." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14"/>
      <ItemsControl ItemsSource="{Binding ReturnedRecords}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="{Binding ConsumerNumber}" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ConsumerName}" Margin="0,6,0,0"/>
        <TextBlock Text="{Binding ReasonToRevert}" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        <TextBlock Text="Server message (verbatim):" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding LastServerMessage}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding LastServerMessageAt}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <Button Content="Open inspection" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6" Command="{Binding DataContext.OpenStoredRecord,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsBlocked,Converter={StaticResource BoolVisibility}}"><StackPanel>
      <TextBlock Text="These records were refused by the state and are waiting on the SDO. Open one to see its state." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14"/>
      <ItemsControl ItemsSource="{Binding BlockedRecords}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="{Binding ConsumerNumber}" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ConsumerName}" Margin="0,6,0,0"/>
        <TextBlock Text="Waiting on SDO:" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding BlockedReason}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding BlockedAt}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <Button Content="Open inspection" HorizontalAlignment="Left" Margin="0,10,0,0" Padding="14,6" Command="{Binding DataContext.OpenStoredRecord,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsNeedsRedo,Converter={StaticResource BoolVisibility}}"><StackPanel>
      <TextBlock Text="These submissions failed and are waiting to be sent again." Foreground="{StaticResource Muted}" FontSize="13" Margin="0,0,0,14"/>
      <ItemsControl ItemsSource="{Binding NeedsRedoRecords}"><ItemsControl.ItemTemplate><DataTemplate>
       <Border Background="{StaticResource Surface}" CornerRadius="14" Padding="18" Margin="0,0,0,12"><StackPanel>
        <TextBlock Text="{Binding ConsumerNumber}" FontSize="19" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding ConsumerName}" Margin="0,6,0,0"/>
        <TextBlock Text="Server message (verbatim):" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,10,0,0"/>
        <TextBlock Text="{Binding LastServerMessage}" FontFamily="Consolas" FontSize="12" TextWrapping="Wrap" Margin="0,4,0,0"/>
        <TextBlock Text="{Binding LastServerMessageAt}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
         <Button Content="Retry submit" Padding="14,6" Command="{Binding DataContext.RetryRecord,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
         <Button Content="Open inspection" Margin="12,0,0,0" Padding="14,6" Command="{Binding DataContext.OpenStoredRecord,RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
        </StackPanel>
       </StackPanel></Border>
      </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
     </StackPanel></ScrollViewer>
     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="{Binding IsFieldPage,Converter={StaticResource BoolVisibility}}"><StackPanel>
      <ItemsControl ItemsSource="{Binding Fields}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,20"><TextBlock Text="{Binding Label}" FontSize="13" Foreground="{StaticResource Muted}"/><TextBlock Text="{Binding Value}" FontSize="17" Margin="0,6,0,0"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
      <Button Content="Copy login structure" Command="{Binding CopyDiagnostics}" HorizontalAlignment="Left" Visibility="{Binding IsDiagnostics,Converter={StaticResource BoolVisibility}}"/>
      <StackPanel Orientation="Horizontal" Visibility="{Binding IsDiagnostics,Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
       <TextBox Text="{Binding IndexPath,UpdateSourceTrigger=PropertyChanged}" Width="520" AutomationProperties.Name="Index file path" ToolTip="Path to index.tsv — the file the harvester walks"/>
       <Button Content="Reload index" Command="{Binding ReloadIndexCommand}" Margin="12,0,0,0" Padding="14,6" ToolTip="Re-read index.tsv and restart the harvester without restarting the app"/>
       <Button Content="Rebuild index from store" Command="{Binding RebuildIndexCommand}" Margin="12,0,0,0" Padding="14,6" AutomationProperties.Name="Rebuild index from store" ToolTip="Rebuild index.tsv from the harvest store, unioned with the pairs the file already holds, then restart the walk from 0"/>
       <Button Content="Resume harvest" Command="{Binding ResumeHarvestCommand}" Margin="12,0,0,0" Padding="14,6" AutomationProperties.Name="Resume harvest" ToolTip="Clear a give-up and arm the walk again from the start of the index"/>
       <Button Content="{Binding ProspectingLabel}" Command="{Binding ToggleProspectingCommand}" Margin="12,0,0,0" Padding="14,6" AutomationProperties.Name="Toggle prospecting" ToolTip="Look for officers the app was never told about. One probe in every eight requests; the walk keeps the other seven."/>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Visibility="{Binding IsDiagnostics,Converter={StaticResource BoolVisibility}}" Margin="0,12,0,0">
       <TextBox Text="{Binding VendorOverride,UpdateSourceTrigger=PropertyChanged}" Width="200" AutomationProperties.Name="Vendor override" ToolTip="Escape hatch. Empty means the record's own vendor_code. When set it replaces BOTH the header and the body, so they always agree."/>
       <TextBlock Text="vendor override (empty = the record's own vendor_code; applied to header AND body)" Foreground="{StaticResource Muted}" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <Button Content="Open inspection (live)" Command="{Binding OpenLiveInspectionCommand}" HorizontalAlignment="Left" Padding="18,8" FontWeight="SemiBold" Visibility="{Binding IsInspectionDetails,Converter={StaticResource BoolVisibility}}"/>
      <Button Content="Open Joint Survey Report" Command="{Binding EditJsr}" HorizontalAlignment="Left" Visibility="{Binding IsJsrDetails,Converter={StaticResource BoolVisibility}}"/>
      </StackPanel></ScrollViewer>
    </Grid>
   </DockPanel>
  </Grid>
 </DockPanel>
</Window>


