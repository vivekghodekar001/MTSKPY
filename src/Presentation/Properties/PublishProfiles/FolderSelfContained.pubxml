<?xml version="1.0" encoding="utf-8"?>
<!-- L1: the portable build. A folder that runs on a laptop with no .NET
     installed: the runtime travels with it. Still a folder - NOT a single
     file, because the SQLite native library is brittle that way - and no
     installer and no machine-wide writes. Everything the app writes at
     runtime stays under %LOCALAPPDATA%\RenewableEnergyDesktop.

     dotnet publish src\Presentation -c Release -p:PublishProfile=FolderSelfContained -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishDir>..\..\artifacts\publish-portable\</PublishDir>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
</Project>
