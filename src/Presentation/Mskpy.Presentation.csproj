<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>MSKPY-Windows</AssemblyName>
    <Version>0.9.0</Version>
    <ApplicationManifest>Mskpy.Presentation.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Application/Mskpy.Application.csproj"/>
    <ProjectReference Include="../Infrastructure/Mskpy.Infrastructure.csproj"/>
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="UiRegression"/>
  </ItemGroup>
  <ItemGroup>
    <PublishProfile Include="FolderProfile"/>
    <PublishProfile Include="FolderSelfContained"/>
  </ItemGroup>
  <!-- L2: the seed index travels with the published folder - it is what the
       app starts with on a fresh machine. -->
  <ItemGroup>
    <Content Include="seed\index.tsv">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
